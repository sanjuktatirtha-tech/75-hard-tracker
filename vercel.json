{
  "version": 2,
  "crons": [
    {
      "path": "/api/morning",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/evening",
      "schedule": "0 15 * * *"
    }
  ],
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
